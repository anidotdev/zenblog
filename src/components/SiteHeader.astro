
---
import site from '../data/site.json';
import { Contrast, Github } from '@lucide/astro';

const socialLinks: { label: string; href: string }[] = [
  { label: 'LinkedIn', href: 'linkedin' in site ? String(site.linkedin ?? '') : '' },
  { label: 'X', href: 'x' in site ? String(site.x ?? '') : '' },
  {
    label: 'Email',
    href: 'email' in site && site.email ? `mailto:${site.email}` : '',
  },
].filter((link) => link.href.trim().length > 0);
---

<header class="site-header page-shell">
  {socialLinks.length > 0 && (
    <nav class="social-nav" aria-label="External links">
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('mailto:') ? undefined : '_blank'}
          rel={link.href.startsWith('mailto:') ? undefined : 'noreferrer'}
        >
          {link.label}<span aria-hidden="true"> ↗</span>
        </a>
      ))}
    </nav>
  )}

  <div class="header-actions" aria-label="Site controls">
    <a
      class="github-link"
      href={site.github}
      target="_blank"
      rel="noreferrer"
      aria-label="GitHub profile (opens in a new tab)"
      title="GitHub"
    >
      <Github
        class="github-icon"
        size={21}
        stroke-width={1.7}
        aria-hidden="true"
      />
    </a>

    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="Switch to dark theme"
      title="Switch to dark theme"
    >
      <Contrast
        class="theme-toggle-icon"
        size={21}
        stroke-width={1.6}
        aria-hidden="true"
      />
      <span class="visually-hidden" data-theme-toggle-label>
        Switch to dark theme
      </span>
    </button>
  </div>
</header>
